digraph "classes_laucher_light" {
rankdir=BT
charset="utf-8"
    bgcolor="#FFFFFF";
    node [shape=record, style=filled, fillcolor="#F0F0F0", fontcolor="#333333", color="#6699CC", penwidth=2];
    edge [color="#999999", fontcolor="#333333"];
    graph [fontname="Helvetica", fontsize=10, labelloc="t", splines=spline];
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=10];

"laucher.ConfigManager" [color="black", fontcolor="black", label=<{ConfigManager|options<br ALIGN="LEFT"/>params<br ALIGN="LEFT"/>|load_json(file_path)<br ALIGN="LEFT"/>save_json(data, file_path)<br ALIGN="LEFT"/>}>, shape="record", style="solid"];
"laucher.ConfigTab" [color="black", fontcolor="black", label=<{ConfigTab|config_manager<br ALIGN="LEFT"/>execution_requested<br ALIGN="LEFT"/>param_widgets : dict<br ALIGN="LEFT"/>run_button<br ALIGN="LEFT"/>runs_per_config_spin<br ALIGN="LEFT"/>total_runs_label<br ALIGN="LEFT"/>unique_configs_label<br ALIGN="LEFT"/>|create_ag_params(layout)<br ALIGN="LEFT"/>create_general_settings(layout)<br ALIGN="LEFT"/>create_run_button(layout)<br ALIGN="LEFT"/>create_summary(layout)<br ALIGN="LEFT"/>init_ui()<br ALIGN="LEFT"/>prepare_and_run()<br ALIGN="LEFT"/>update_summary(_)<br ALIGN="LEFT"/>}>, shape="record", style="solid"];
"laucher.ExecutionTab" [color="black", fontcolor="black", label=<{ExecutionTab|config_manager<br ALIGN="LEFT"/>configurations : list<br ALIGN="LEFT"/>current_config_group<br ALIGN="LEFT"/>current_config_label<br ALIGN="LEFT"/>current_run_number : int<br ALIGN="LEFT"/>execution_thread : NoneType<br ALIGN="LEFT"/>log_text<br ALIGN="LEFT"/>progress_bar<br ALIGN="LEFT"/>run_dashboard_btn<br ALIGN="LEFT"/>runs_per_config : int<br ALIGN="LEFT"/>stop_btn<br ALIGN="LEFT"/>total_runs : int<br ALIGN="LEFT"/>|append_log(message)<br ALIGN="LEFT"/>create_control_buttons(layout)<br ALIGN="LEFT"/>create_log_area(layout)<br ALIGN="LEFT"/>create_progress_bar(layout)<br ALIGN="LEFT"/>create_status_panel(layout)<br ALIGN="LEFT"/>init_ui()<br ALIGN="LEFT"/>on_all_executions_finished(success, message)<br ALIGN="LEFT"/>on_single_execution_finished(success, message)<br ALIGN="LEFT"/>run_dashboard()<br ALIGN="LEFT"/>run_next_configuration()<br ALIGN="LEFT"/>start_executions(configurations, runs_per_config)<br ALIGN="LEFT"/>stop_execution()<br ALIGN="LEFT"/>}>, shape="record", style="solid"];
"laucher.ExecutionThread" [color="black", fontcolor="black", label=<{ExecutionThread|args : list<br ALIGN="LEFT"/>execution_finished<br ALIGN="LEFT"/>log_updated<br ALIGN="LEFT"/>process : NoneType, Popen<br ALIGN="LEFT"/>script_path<br ALIGN="LEFT"/>|run()<br ALIGN="LEFT"/>stop()<br ALIGN="LEFT"/>}>, shape="record", style="solid"];
"laucher.LauncherWindow" [color="black", fontcolor="black", label=<{LauncherWindow|config_manager<br ALIGN="LEFT"/>config_tab<br ALIGN="LEFT"/>execution_tab<br ALIGN="LEFT"/>|create_header(layout)<br ALIGN="LEFT"/>create_tabs(layout)<br ALIGN="LEFT"/>init_ui()<br ALIGN="LEFT"/>}>, shape="record", style="solid"];
"laucher.ConfigManager" -> "laucher.LauncherWindow" [arrowhead="diamond", arrowtail="none", fontcolor="green", label="config_manager", style="solid"];
"laucher.ConfigTab" -> "laucher.LauncherWindow" [arrowhead="diamond", arrowtail="none", fontcolor="green", label="config_tab", style="solid"];
"laucher.ExecutionTab" -> "laucher.LauncherWindow" [arrowhead="diamond", arrowtail="none", fontcolor="green", label="execution_tab", style="solid"];
"laucher.ExecutionThread" -> "laucher.ExecutionTab" [arrowhead="diamond", arrowtail="none", fontcolor="green", label="execution_thread", style="solid"];
}