graph TD
    subgraph User Configuration
        A[params.json] -- Base AG Parameters --> C
        B[options.json] -- Varying Parameters & Repetitions --> C
    end

    subgraph Launcher (laucher.py)
        C[ConfigManager] -- Reads & Manages --> A
        C -- Reads & Manages --> B
        D[ConfigTab] -- Configures & Saves --> A
        D -- Configures & Saves --> B
        E[ExecutionTab] -- Triggers Execution --> F
    end

    subgraph Core Execution (run_execution.py)
        F[run_execution.py] -- Reads --> A
        F -- Reads --> B
        F -- Instantiates --> G[Setup Object]
        F -- For Each Execution --> H[AlgoritimoEvolutivoRCE Instance]
        H -- Uses --> G
        H -- Calls --> I[funcao_objetivo_IEEE14]
        I -- Performs Simulation --> J[RedeEletricaPandaPower Instance]
        H -- Returns --> K[Best Individual & Visualization Data]
        F -- Saves Results --> L[config_X_exec_Y_results.json]
        F -- Saves Visualization --> M[config_X_exec_Y_visualization.json]
    end

    subgraph Output Structure (src/output/)
        N[run_YYYY-MM-DD_HH-MM-SS/] -- Contains --> O[config_X/]
        O -- Contains --> L
        O -- Contains --> M
    end

    subgraph Data Consolidation
        P[consolidar_resultados.py] -- Reads All --> L
        P -- Consolidates & Saves --> Q[resultados_consolidados.xlsx]
    end

    subgraph Dashboard (Streamlit App)
        R[dashboard_RCE_APP.py] -- Loads Visualization Data From --> M
        R -- Loads Consolidated Data From --> Q
        S[FramewrokRCEDashboardPage.py] -- Renders Visualizations --> R
    end

    %% Styling for clarity
    style A fill:#f9f,stroke:#333,stroke-width:2px
    style B fill:#f9f,stroke:#333,stroke-width:2px
    style L fill:#afa,stroke:#333,stroke-width:2px
    style M fill:#afa,stroke:#333,stroke-width:2px
    style Q fill:#afa,stroke:#333,stroke-width:2px

    %% Data Flow Connections
    A -- Updates --> D
    B -- Updates --> D
    D -- Triggers --> E
    E -- Starts --> F
    F -- Passes Setup --> H
    H -- Uses --> G
    H -- Calls --> I
    I -- Uses --> J
    J -- Performs Simulation --> I
    F -- Receives --> K
    K -- Saved As --> L
    K -- Saved As --> M
    L -- Read By --> P
    M -- Read By --> R
    Q -- Read By --> R
    R -- Displays --> S

