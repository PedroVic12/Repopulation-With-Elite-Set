digraph "classes_rede_eletrica_light" {
rankdir=BT
charset="utf-8"
    bgcolor="#FFFFFF";
    node [shape=record, style=filled, fillcolor="#F0F0F0", fontcolor="#333333", color="#6699CC", penwidth=2];
    edge [color="#999999", fontcolor="#333333"];
    graph [fontname="Helvetica", fontsize=10, labelloc="t", splines=spline];
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=10];

"rede_eletrica.Logger" [color="black", fontcolor="black", label=<{Logger|console : Console<br ALIGN="LEFT"/>|log(message, level)<br ALIGN="LEFT"/>}>, shape="record", style="solid"];
"rede_eletrica.SmartGridNetwork" [color="black", fontcolor="black", label=<{SmartGridNetwork|agendamento : DataFrame<br ALIGN="LEFT"/>console<br ALIGN="LEFT"/>contingencia : DataFrame<br ALIGN="LEFT"/>debug : bool<br ALIGN="LEFT"/>mapeamento_ramos : dict<br ALIGN="LEFT"/>net<br ALIGN="LEFT"/>nome_rede : str<br ALIGN="LEFT"/>pesos : dict<br ALIGN="LEFT"/>|ajustar_cargas(perfil)<br ALIGN="LEFT"/>aplicar_contingencia(tipo_elemento, elemento_id)<br ALIGN="LEFT"/>avalia_cenarios(horas: int, hora_inicio: list, duracao: list, ls, le, ms, me, hs, he, debug)<br ALIGN="LEFT"/>calcular_perfil(j, ls, le, ms, me, hs, he)<br ALIGN="LEFT"/>calcular_violacoes_fitness()<br ALIGN="LEFT"/>criar_mapeamento_ramos()<br ALIGN="LEFT"/>desligar_contingencia(ramo)<br ALIGN="LEFT"/>desligar_elementos(linhas_desligar, trafos_desligar)<br ALIGN="LEFT"/>desligar_elementos_agendamento(estados)<br ALIGN="LEFT"/>executar_fluxo_de_potencia(fast)<br ALIGN="LEFT"/>hashtableindex(carregamento, n_carregamentos, contingencia, n_contingencias, desligamentos)<br ALIGN="LEFT"/>loading_networks_cases(network_name)<br ALIGN="LEFT"/>log(mensagem, level)<br ALIGN="LEFT"/>religar_todos_os_ramos_agendamento()<br ALIGN="LEFT"/>resetar_rede()<br ALIGN="LEFT"/>show_status(debug)<br ALIGN="LEFT"/>validar_dados(df_agendamento, df_contingencia)<br ALIGN="LEFT"/>}>, shape="record", style="solid"];
"rede_eletrica.Logger" -> "rede_eletrica.SmartGridNetwork" [arrowhead="diamond", arrowtail="none", fontcolor="green", label="console", style="solid"];
}