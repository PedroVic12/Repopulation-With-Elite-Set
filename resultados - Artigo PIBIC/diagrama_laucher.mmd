flowchart TB
    %% --- Usuário
    subgraph U["Usuário"]
        A["Launcher PySide6"]:::launcher
    end

    %% --- Backend
    subgraph B["Backend (Execução)"]
        B1["run_execution.py"]
        B2{"Loop de Otimização DEAP"}
        B3["Cálculo de Fluxo de Potência com Pandapower"]
    end

    %% --- Visualização
    subgraph V["Visualização"]
        C["Dashboard Streamlit"]:::streamlit
    end

    %% --- Armazenamento
    subgraph S["Armazenamento"]
        S1["Arquivos de Configuração .json"]:::storage
        S2["Arquivos de Resultado .json/.pkl"]:::storage
        S3["Resultados Consolidados .xlsx"]:::storage
    end

    %% Fluxos principais
    A -->|"Executa"| B1
    A -->|"Salva"| S1
    A -->|"Exibe"| C

    B1 -->|"Carrega Configs"| S1
    B1 --> B2

    B2 -->|"Para cada indivíduo"| B3
    B3 -->|"Retorna Fitness"| B2
    B2 -->|"Salva Parâmetros"| S1
    B2 -->|"Gera Resultados"| S2

    C -->|"Lê Configs"| S1
    C -->|"Exibe Resultados"| S2
    C -->|"Gera e Exibe"| S3

    %% --- Estilos
    classDef launcher fill:#c6e6fa,stroke:#036,stroke-width:2px;
    classDef streamlit fill:#9fffb2,stroke:#060,stroke-width:2px;
    classDef storage fill:#fff7a8,stroke:#660,stroke-width:2px;
