<?xml version="1.0" encoding="UTF-8"?>
<!--
    launcher_window.ui
    Qt Designer UI file — Janela Principal do RCE Framework Launcher

    Como usar:
      1) Editar visualmente:  designer ui/launcher_window.ui
      2) Gerar Python:        pyside6-uic ui/launcher_window.ui -o ui/ui_launcher_window.py
      3) Carregar em tempo de execução (forma usada neste projeto):
            from PySide6.QtUiTools import QUiLoader
            loader = QUiLoader()
            ui = loader.load("ui/launcher_window.ui", self)
         — ou —
            from PySide6.QtCore import QFile
            ui_file = QFile("ui/launcher_window.ui")
            loader.load(ui_file, self)

    Objetos importantes (acessíveis via self.ui.<objectName>):
        central_widget    — QWidget central
        left_menu         — QFrame menu lateral esquerdo (fixedWidth=240)
        toggle_button     — QPushButton "☰" para expandir/recolher menu
        nav_menu_container— QWidget placeholder onde NavigationMenu é injetado
        tabs              — QTabWidget área de conteúdo principal
-->
<ui version="4.0">
 <class>LauncherWindow</class>
 <widget class="QMainWindow" name="LauncherWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1280</width>
    <height>800</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>RCE Framework Launcher MVC</string>
  </property>
  <widget class="QWidget" name="central_widget">
   <property name="objectName">
    <string>central_widget</string>
   </property>
   <layout class="QHBoxLayout" name="main_layout">
    <property name="spacing">
     <number>0</number>
    </property>
    <property name="leftMargin">
     <number>0</number>
    </property>
    <property name="topMargin">
     <number>0</number>
    </property>
    <property name="rightMargin">
     <number>0</number>
    </property>
    <property name="bottomMargin">
     <number>0</number>
    </property>

    <!-- ============================================================ -->
    <!-- MENU LATERAL ESQUERDO                                        -->
    <!-- ============================================================ -->
    <item>
     <widget class="QFrame" name="left_menu">
      <property name="minimumWidth">
       <number>240</number>
      </property>
      <property name="maximumWidth">
       <number>240</number>
      </property>
      <property name="styleSheet">
       <string>background-color: #1a1a1a;</string>
      </property>
      <property name="frameShape">
       <enum>QFrame::StyledPanel</enum>
      </property>
      <layout class="QVBoxLayout" name="left_menu_layout">
       <property name="spacing">
        <number>0</number>
       </property>
       <property name="leftMargin">
        <number>0</number>
       </property>
       <property name="topMargin">
        <number>0</number>
       </property>
       <property name="rightMargin">
        <number>0</number>
       </property>
       <property name="bottomMargin">
        <number>0</number>
       </property>

       <!-- Botão toggle hamburger -->
       <item>
        <widget class="QPushButton" name="toggle_button">
         <property name="text">
          <string>☰</string>
         </property>
         <property name="minimumSize">
          <size>
           <width>40</width>
           <height>40</height>
          </size>
         </property>
         <property name="maximumSize">
          <size>
           <width>40</width>
           <height>40</height>
          </size>
         </property>
         <property name="toolTip">
          <string>Expandir / Recolher menu</string>
         </property>
        </widget>
       </item>

       <!-- Placeholder onde NavigationMenu (QWidget) é inserido via código -->
       <item>
        <widget class="QWidget" name="nav_menu_container">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Preferred" vsizetype="Expanding">
           <horstretch>0</horstretch>
           <verstretch>1</verstretch>
          </sizepolicy>
         </property>
        </widget>
       </item>

      </layout>
     </widget>
    </item>

    <!-- ============================================================ -->
    <!-- ÁREA CENTRAL — QTabWidget                                    -->
    <!-- ============================================================ -->
    <item>
     <widget class="QTabWidget" name="tabs">
      <property name="tabsClosable">
       <bool>true</bool>
      </property>
      <property name="movable">
       <bool>true</bool>
      </property>
      <property name="documentMode">
       <bool>false</bool>
      </property>
     </widget>
    </item>

   </layout>
  </widget>
  <!-- Barra de status (opcional) -->
  <widget class="QStatusBar" name="statusbar"/>
 </widget>

 <!-- ============================================================ -->
 <!-- RECURSOS (ícones, imagens)                                   -->
 <!-- adicione aqui seu .qrc se necessário                         -->
 <!-- ============================================================ -->
 <resources/>
 <connections/>
</ui>
