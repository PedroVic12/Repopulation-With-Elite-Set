digraph "classes_Projeto" {
rankdir=BT
charset="utf-8"
"rede_eletrica.Logger" [color="black", fontcolor="black", label=<{Logger|console : Console<br ALIGN="LEFT"/>|log(message, level)<br ALIGN="LEFT"/>}>, shape="record", style="solid"];
"rede_eletrica.RedeEletricaPandaPower" [color="black", fontcolor="black", label=<{RedeEletricaPandaPower|agendamento : DataFrame<br ALIGN="LEFT"/>console<br ALIGN="LEFT"/>contingencia : DataFrame<br ALIGN="LEFT"/>debug : bool<br ALIGN="LEFT"/>mapeamento_ramos : dict<br ALIGN="LEFT"/>net<br ALIGN="LEFT"/>network_name : str<br ALIGN="LEFT"/>pesos : dict<br ALIGN="LEFT"/>|add_barras(net, barras)<br ALIGN="LEFT"/>add_cargas(net, cargas)<br ALIGN="LEFT"/>add_ext_grid(net, bus, vm_pu, name)<br ALIGN="LEFT"/>add_geradores(net, geradores)<br ALIGN="LEFT"/>add_linhas(net, linhas)<br ALIGN="LEFT"/>ajustar_cargas(perfil)<br ALIGN="LEFT"/>aplicar_contingencia(tipo_elemento, elemento_id)<br ALIGN="LEFT"/>avalia_cenarios(horas: int, hora_inicio: list, duracao: list, ls, le, ms, me, hs, he, debug)<br ALIGN="LEFT"/>calcular_perfil(j, ls, le, ms, me, hs, he)<br ALIGN="LEFT"/>calcular_potencia_aparente_linhas()<br ALIGN="LEFT"/>calcular_potencia_aparente_trafos()<br ALIGN="LEFT"/>calcular_violacoes_fitness()<br ALIGN="LEFT"/>create_network()<br ALIGN="LEFT"/>criar_mapeamento_ramos()<br ALIGN="LEFT"/>desligar_contingencia(ramo)<br ALIGN="LEFT"/>desligar_elementos(linhas_desligar, trafos_desligar)<br ALIGN="LEFT"/>desligar_elementos_agendamento(estados)<br ALIGN="LEFT"/>executar_fluxo_de_potencia(fast)<br ALIGN="LEFT"/>hashtableindex(carregamento, n_carregamentos, contingencia, n_contingencias, desligamentos)<br ALIGN="LEFT"/>imprimir_resultados()<br ALIGN="LEFT"/>loading_networks_cases(network_name)<br ALIGN="LEFT"/>log(mensagem, level)<br ALIGN="LEFT"/>plot_all_results_to_html(output_file)<br ALIGN="LEFT"/>plot_diagrama_cenario(net)<br ALIGN="LEFT"/>plot_potencia_ativa_reativa()<br ALIGN="LEFT"/>plot_power_data(index)<br ALIGN="LEFT"/>plot_rede_eletrica_status(trafo_status, line_status)<br ALIGN="LEFT"/>plot_trafo_status(net)<br ALIGN="LEFT"/>plot_trafo_status_only(net)<br ALIGN="LEFT"/>religar_todos_os_ramos_agendamento()<br ALIGN="LEFT"/>resetar_rede()<br ALIGN="LEFT"/>show_status(debug)<br ALIGN="LEFT"/>simulate_network_functional()<br ALIGN="LEFT"/>validar_dados(df_agendamento, df_contingencia)<br ALIGN="LEFT"/>}>, shape="record", style="solid"];
